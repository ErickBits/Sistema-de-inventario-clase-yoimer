# Cadena de conexión de MongoDB Atlas (los clusters de Atlas ya son replica sets => soportan transacciones)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/ventas_inventario?retryWrites=true&w=majority
PORT=4000
# Base de datos usada por la suite de pruebas (¡se vacía en cada ejecución!)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/ventas_inventario_test?replicaSet=rs0
